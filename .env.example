PORT=4180
HOST=127.0.0.1
TRUST_PROXY_HOPS=0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=arc
DB_USER=arca_app
DB_PASSWORD=REEMPLAZAR_POR_UNA_CLAVE_PRIVADA
DB_SSL=false
# Aiven: reemplaza DB_HOST/PORT/NAME/USER/PASSWORD por los datos del servicio.
# Usa DB_SSL=true y el certificado CA descargado de Aiven.
# En Vercel usa DB_SSL_CA con el PEM completo (o saltos de línea escritos como \n).
# En tu equipo puedes usar DB_SSL_CA_PATH=runtime/aiven-ca.pem.
DB_SSL_CA=
DB_SSL_CA_PATH=
DB_CONNECTION_LIMIT=8
DB_CONNECT_TIMEOUT=10000
NODE_ENV=development

# Origen local para db:export. Copia aquí tus valores locales ANTES de cambiar DB_*.
# No se envían a Vercel. El exportador solo lee esta base.
SOURCE_DB_HOST=127.0.0.1
SOURCE_DB_PORT=3306
SOURCE_DB_NAME=arc
SOURCE_DB_USER=arca_app
SOURCE_DB_PASSWORD=
SOURCE_DB_SSL=false

# Solo para db:import y db:migrate si DB_USER tiene permisos limitados.
# No configurar en Vercel. Necesitan permisos de CREATE/ALTER y escritura.
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=

# Opcional: exportador local. En Windows se detecta C:/xampp/mysql/bin.
# MYSQLDUMP_BIN=C:/xampp/mysql/bin/mysqldump.exe
